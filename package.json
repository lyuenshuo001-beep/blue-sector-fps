{
  "name": "twinkle-ops",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native --host 0.0.0.0",
    "build": "tsc --noEmit && vite build --configLoader native && node scripts/build-sw.mjs",
    "preview": "vite preview --configLoader native --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/upgrade.mjs",
    "deploy:china": "node scripts/deploy-oss.mjs",
    "test:pwa": "node tests/pwa.mjs",
    "test:webkit": "node tests/combat-v2.mjs",
    "test:mechanics": "node tests/regression-v2.mjs && node tests/combat-v2.mjs",
    "test:live": "node tests/live.mjs",
    "assets:infected": "node scripts/build-infected.mjs",
    "test:pve": "node tests/pve.mjs",
    "assets:voice": "node scripts/build-voice.mjs",
    "test:campaign": "node tests/campaign.mjs && node tests/campaign-controls.mjs && node tests/campaign-combat.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "ali-oss": "^6.23.0",
    "playwright": "^1.56.0",
    "text2wav": "^0.0.14",
    "typescript": "~5.9.3",
    "vite": "^7.1.7"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
